{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]; then echo 'Skipping preview deploy (branch != main)'; exit 0; fi; git diff --quiet HEAD^ HEAD -- ':(exclude)public/marketing/' ':(exclude)public/screenshots/' ':(exclude)**/*.md' ':(exclude)docs/' ':(exclude)supabase/migrations/'",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "github": {
    "silent": false,
    "autoAlias": true
  },
  "crons": [
    {
      "path": "/api/cron/task-jobs?job=reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/task-jobs?job=recurring",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/task-jobs?job=rotation",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/task-jobs?job=cleanup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/task-jobs?job=refresh-views",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/reminder-notifications",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cleanup-deleted-accounts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/process-notifications",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-deletions",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/ai-data-cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
