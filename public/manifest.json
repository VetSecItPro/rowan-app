{
  "name": "Rowan - Your Life, Organized",
  "short_name": "Rowan",
  "description": "Collaborative life management for couples and families. Track tasks, expenses, meals, reminders, and more — all in one beautiful app.",
  "start_url": "/dashboard",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "any",
  "categories": ["productivity", "lifestyle", "utilities", "family"],
  "lang": "en-US",
  "dir": "ltr",
  "scope": "/",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "/rowan-icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/rowan-icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/rowan-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/rowan-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/rowan-logo-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Task",
      "short_name": "Task",
      "description": "Create a new task",
      "url": "/tasks?action=new",
      "icons": [{ "src": "/rowan-icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "New Reminder",
      "short_name": "Reminder",
      "description": "Create a new reminder",
      "url": "/reminders?action=new",
      "icons": [{ "src": "/rowan-icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Shopping List",
      "short_name": "Shopping",
      "description": "View shopping lists",
      "url": "/shopping",
      "icons": [{ "src": "/rowan-icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "description": "View calendar events",
      "url": "/calendar",
      "icons": [{ "src": "/rowan-icon-96.png", "sizes": "96x96" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/dashboard-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Rowan Dashboard on mobile"
    },
    {
      "src": "/screenshots/tasks-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Rowan Tasks on mobile"
    },
    {
      "src": "/screenshots/dashboard-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Rowan Dashboard on desktop"
    },
    {
      "src": "/screenshots/calendar-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Rowan Calendar on desktop"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share/submit",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/calendar",
            ".ics",
            "image/*",
            "text/plain"
          ]
        }
      ]
    }
  }
}
